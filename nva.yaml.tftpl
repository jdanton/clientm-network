#cloud-config
# ============================================================================
# NVA cloud-init — Linux + iptables firewall.
#
# Topology: Internet → AppGW → InternalLB → THIS NVA → Webserver
#
# Inbound:
#   - LB rewrites dst from LB IP to this NVA's trust IP (floating_ip=false).
#   - NVA PREROUTING DNAT on trust NIC: dst :443 → webserver:443.
#   - NVA POSTROUTING SNAT on DMZ NIC: src → NVA's DMZ IP (so the webserver
#     replies directly to this NVA, not via any LB hash on the return path).
#
# Return (webserver → NVA → LB → AppGW → client):
#   - Webserver replies to NVA's DMZ IP (same subnet, no LB).
#   - NVA conntrack reverses both NATs.
#   - Reply leaves NVA's trust NIC with src = NVA trust IP.
#   - Internal LB matches the connection by 5-tuple and rewrites src to LB IP.
#   - App GW receives reply from LB IP — matches its expected backend.
#
# Lessons baked in from prior attempts:
#   * Detect interfaces by subnet (Linux assigns eth* in MAC/PCI order, not
#     Terraform-resource order).
#   * Per-NIC rp_filter=0 set dynamically (sysctl-by-name was unreliable).
#   * Policy-based routing per NIC IP so LB probe SYN-ACKs leave via the
#     same NIC the SYN arrived on (Azure LB rejects probe replies that
#     egress a different interface from the one probed).
#   * Don't MASQUERADE traffic to 168.63.129.16 (Azure platform IP) — the
#     SNAT rewrites the source of LB probe replies and breaks them.
# ============================================================================
package_update: true
package_upgrade: false
packages:
  - iptables
  - iptables-persistent
  - netfilter-persistent
  - conntrack
  - tcpdump
  - net-tools
  - traceroute
  - mtr-tiny

write_files:
  - path: /etc/sysctl.d/99-nva.conf
    permissions: '0644'
    content: |
      net.ipv4.ip_forward = 1
      net.ipv4.conf.all.rp_filter = 0
      net.ipv4.conf.default.rp_filter = 0
      # Strict conntrack — matches enterprise firewall behavior (asymmetric
      # returns get tagged INVALID instead of silently re-tracked).
      net.netfilter.nf_conntrack_tcp_loose = 0
      net.netfilter.nf_conntrack_max = 65536

  - path: /usr/local/sbin/nva-firewall.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      WEBSERVER_IP="${webserver_ip}"
      TRUST_CIDR="${trust_cidr}"
      DMZ_CIDR="${dmz_cidr}"
      APPGW_SUBNET_CIDR="${appgw_subnet_cidr}"

      # ----- Detect interfaces by subnet (don't trust eth* names) -----
      iface_in_subnet() {
        local cidr="$1"
        local prefix
        prefix=$(echo "$cidr" | awk -F'.' '{print $1"."$2"."$3"."}')
        for iface in $(ls /sys/class/net/ | grep -v '^lo$'); do
          if ip -4 -o addr show "$iface" 2>/dev/null | awk '{print $4}' | grep -q "^$prefix"; then
            echo "$iface"; return
          fi
        done
      }
      TRUST_IF=$(iface_in_subnet "$TRUST_CIDR")
      DMZ_IF=$(iface_in_subnet "$DMZ_CIDR")
      [ -z "$TRUST_IF" ] || [ -z "$DMZ_IF" ] && {
        logger -t nva-firewall "ERROR: failed to detect interfaces (trust=$TRUST_IF dmz=$DMZ_IF)"
        exit 1
      }
      TRUST_IP=$(ip -4 -o addr show "$TRUST_IF" | awk '{print $4}' | cut -d/ -f1)
      DMZ_IP=$(ip -4 -o addr show "$DMZ_IF" | awk '{print $4}' | cut -d/ -f1)
      TRUST_GW=$(echo "$TRUST_IP" | awk -F. '{print $1"."$2"."$3".1"}')
      DMZ_GW=$(echo "$DMZ_IP" | awk -F. '{print $1"."$2"."$3".1"}')
      logger -t nva-firewall "trust=$TRUST_IF($TRUST_IP) dmz=$DMZ_IF($DMZ_IP)"

      # Per-NIC rp_filter (sysctl-by-name doesn't work when names are reordered)
      echo 0 > "/proc/sys/net/ipv4/conf/$TRUST_IF/rp_filter"
      echo 0 > "/proc/sys/net/ipv4/conf/$DMZ_IF/rp_filter"

      # ----- Policy-based routing -----
      # Replies sourced from each NIC's IP must egress that same NIC, otherwise
      # Azure LB rejects health probe responses (it received the probe at a
      # specific backend IP and expects the SYN-ACK to come back over the
      # corresponding path).
      grep -q '^100 t-trust' /etc/iproute2/rt_tables || echo "100 t-trust" >> /etc/iproute2/rt_tables
      grep -q '^101 t-dmz'   /etc/iproute2/rt_tables || echo "101 t-dmz"   >> /etc/iproute2/rt_tables
      ip route flush table 100 2>/dev/null || true
      ip route flush table 101 2>/dev/null || true
      ip route add default via "$TRUST_GW" dev "$TRUST_IF" table 100
      ip route add default via "$DMZ_GW"   dev "$DMZ_IF"   table 101
      ip rule del from "$TRUST_IP" table 100 2>/dev/null || true
      ip rule del from "$DMZ_IP"   table 101 2>/dev/null || true
      ip rule add from "$TRUST_IP" table 100
      ip rule add from "$DMZ_IP"   table 101

      # ----- iptables -----
      iptables -F
      iptables -t nat -F
      iptables -t mangle -F
      iptables -X

      iptables -P INPUT  ACCEPT
      iptables -P OUTPUT ACCEPT
      iptables -P FORWARD DROP

      # Stateful FORWARD
      iptables -A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
      iptables -A FORWARD -m conntrack --ctstate INVALID -j DROP
      # New inbound HTTPS to webserver (after the trust-NIC DNAT below)
      iptables -A FORWARD -p tcp --dport 443 -d "$WEBSERVER_IP" -m conntrack --ctstate NEW -j ACCEPT
      iptables -A FORWARD -p tcp --dport 80  -d "$WEBSERVER_IP" -m conntrack --ctstate NEW -j ACCEPT
      # New flows from the AppGw subnet (covers App GW backend traffic via Internal LB)
      iptables -A FORWARD -s "$APPGW_SUBNET_CIDR" -m conntrack --ctstate NEW -j ACCEPT
      # New flows from DMZ (webserver egress for updates etc.)
      iptables -A FORWARD -s "$DMZ_CIDR" -m conntrack --ctstate NEW -j ACCEPT

      # ----- NAT -----
      # DNAT inbound from Internal LB → webserver. The LB rewrites dst from
      # the LB IP to this NVA's trust IP (floating_ip=false), so we match
      # on -i $TRUST_IF + dport, not on a specific destination IP.
      iptables -t nat -A PREROUTING -i "$TRUST_IF" -p tcp --dport 443 -j DNAT --to-destination "$WEBSERVER_IP:443"
      iptables -t nat -A PREROUTING -i "$TRUST_IF" -p tcp --dport 80  -j DNAT --to-destination "$WEBSERVER_IP:80"

      # SNAT on the DMZ NIC: webserver sees src = NVA's DMZ IP, replies to it
      # directly (same subnet, no LB hashing on the return path → symmetric).
      iptables -t nat -A POSTROUTING -o "$DMZ_IF" -d "$WEBSERVER_IP" -j MASQUERADE

      # Don't MASQUERADE LB probe replies — Azure LB validates the response
      # source IP and the SNAT would rewrite it.
      iptables -t nat -A POSTROUTING -o "$TRUST_IF" -d 168.63.129.16 -j RETURN

      # NVA's own outbound to the internet (apt updates, etc.) via trust NIC.
      iptables -t nat -A POSTROUTING -o "$TRUST_IF" ! -d 10.0.0.0/8 -j MASQUERADE

      netfilter-persistent save
      logger -t nva-firewall "NVA firewall rules applied. trust=$TRUST_IF($TRUST_IP) dmz=$DMZ_IF($DMZ_IP) webserver=$WEBSERVER_IP"

  - path: /etc/systemd/system/nva-firewall.service
    permissions: '0644'
    content: |
      [Unit]
      Description=NVA firewall rules
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/nva-firewall.sh
      RemainAfterExit=yes

      [Install]
      WantedBy=multi-user.target

runcmd:
  - modprobe nf_conntrack
  - echo nf_conntrack > /etc/modules-load.d/nf_conntrack.conf
  - sysctl --system
  - systemctl daemon-reload
  - systemctl enable --now nva-firewall.service
  - |
    cat > /usr/local/bin/nva-trace <<'EOF'
    #!/bin/bash
    echo "=== interfaces ==="
    ip -4 -br addr
    echo ""
    echo "=== ip rule ==="
    ip rule
    echo ""
    echo "=== iptables FORWARD ==="
    iptables -L FORWARD -v -n --line-numbers
    echo ""
    echo "=== iptables NAT PREROUTING ==="
    iptables -t nat -L PREROUTING -v -n --line-numbers
    echo ""
    echo "=== iptables NAT POSTROUTING ==="
    iptables -t nat -L POSTROUTING -v -n --line-numbers
    echo ""
    echo "=== conntrack (last 20) ==="
    conntrack -L 2>/dev/null | tail -20
    EOF
  - chmod +x /usr/local/bin/nva-trace

final_message: "NVA bootstrap complete. Run 'sudo nva-trace' to inspect firewall state."
