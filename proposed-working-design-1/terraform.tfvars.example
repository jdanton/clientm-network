# Copy to terraform.tfvars and fill in.

# Your SSH public key (paste contents of ~/.ssh/<key>.pub)
ssh_public_key = "ssh-rsa AAAA... your-key-here"

# Your public IP /32 (curl ifconfig.me) — locks SSH to NVA management IPs
allowed_ssh_cidr = "1.2.3.4/32"

# Optional overrides
# location            = "eastus"
# resource_group_name = "rg-clientm-lab"
# vm_size             = "Standard_B2s"
